<Project>

    <!--
      Documentation files are generated so that the compiler resolves every cref in an XML comment.
      An unresolved one is an error, not a warning: a comment pointing at a type that no longer exists
      is how the source tree grew three descriptions of mechanisms that were already deleted.
      CS1591 stays off — documentation lives at the interface level, so implementations carry none.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);CS1574;CS1580;CS1581;CS1584;CS1710;CS1723</WarningsAsErrors>
    </PropertyGroup>

</Project>
